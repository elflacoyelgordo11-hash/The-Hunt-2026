local stopsRunning = false

MainTab:CreateButton({
    Name = "Get Pizza and Put In Place(2010)",
    Callback = function()
        if stopsRunning then return end

        local char = Players.LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if not (root and humanoid) then
            Rayfield:Notify({
                Title = "No character",
                Content = "HumanoidRootPart or Humanoid not found.",
                Duration = 4,
            })
            return
        end

        stopsRunning = true
        if ANCHOR_DURING_STEPS then root.Anchored = true end
        local currentStop = 0

        local ok, err = pcall(function()
            for i, step in ipairs(STOP_STEPS) do
                currentStop = i
                assert(root.Parent and humanoid.Health > 0, "character died or respawned")

                -- Tween to this stop
                local distance = (root.Position - step.pos).Magnitude
                local time = math.max(distance / TWEEN_SPEED, 0.3)
                local tween = TweenService:Create(
                    root,
                    TweenInfo.new(time, Enum.EasingStyle.Linear),
                    {CFrame = CFrame.new(step.pos)}
                )
                tween:Play()
                task.wait(time + 0.1) -- timed wait so a dead character can't hang the loop
                assert(root.Parent and humanoid.Health > 0, "character died or respawned")
                task.wait(PROMPT_DELAY)

                -- Fire this stop's ProximityPrompt, if it has one
                if step.prompt then
                    local fired, fireErr = pcall(function()
                        local prompt = step.prompt()
                        assert(prompt, "ProximityPrompt not found")
                        fireproximityprompt(prompt)
                    end)
                    if not fired then
                        Rayfield:Notify({
                            Title = "Prompt " .. i .. " failed",
                            Content = tostring(fireErr),
                            Duration = 5,
                        })
                    end
                end
            end
        end)

        stopsRunning = false
        if ANCHOR_DURING_STEPS and root.Parent then root.Anchored = false end

        if not ok then
            Rayfield:Notify({
                Title = "Stopped at stop " .. currentStop,
                Content = tostring(err),
                Duration = 6,
            })
        end
    end,
})


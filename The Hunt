        prompt = function()
            return workspace["-2876.28_39.70_434.75"].Part.ProximityPrompt
        end,
    },
    {
        pos = Vector3.new(-2920.235107421875, 12.476578712463379, 249.28457641601562),
        prompt = function()
            local container = workspace["-2920.39_10.30_249.14"]
